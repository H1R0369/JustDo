<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JustDo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/shared/typography.css">
    <link rel="stylesheet" href="styles/shared/global.css">
    <link rel="stylesheet" href="styles/pages/index.css">

</head>
<body>
    <!-- ========== MAIN CONTAINER ========== -->
    <div
        class="main-container"
    >
        <!-- ===== HEADER ===== -->
        <header>
            <!-- ---------- Main Navbar ---------- -->
            <nav
                class="main-nav"
            >
                <!-- ----- Logo Container ----- -->
                <div
                    class="logo-container"
                >
                    <h5>JustD</h5>
                    <img src="assets/svg/tick.svg" width="30px" alt="tick-icon">

                </div>
                <!-- Burger Icon -->
                <a class="burger-anc">
                    <svg width="30px" height="30px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path class="svg-color" fill-rule="evenodd" clip-rule="evenodd" d="M4 5C3.44772 5 3 5.44772 3 6C3 6.55228 3.44772 7 4 7H20C20.5523 7 21 6.55228 21 6C21 5.44772 20.5523 5 20 5H4ZM7 12C7 11.4477 7.44772 11 8 11H20C20.5523 11 21 11.4477 21 12C21 12.5523 20.5523 13 20 13H8C7.44772 13 7 12.5523 7 12ZM13 18C13 17.4477 13.4477 17 14 17H20C20.5523 17 21 17.4477 21 18C21 18.5523 20.5523 19 20 19H14C13.4477 19 13 18.5523 13 18Z" fill="#000000"/>
                    </svg>
                </a></a>

            </nav>
            <!-- Curtain Navbar -->
            <nav
                class="nav-curtain"
            >
                <ul
                    class="nav-curtain-links"
                >
                    <li><a href="#" class="nav-link-about"> About </a></li>
                    <li><a href="#" class="nav-link-tutorial"> Tutorial </a></li>
                    <li><a href="#" class="nav-link-contact"> Contact </a></li>

                </ul>
            </nav>

        </header>

        <!-- ===== MAIN ===== -->
        <main>
            
            <form action="/tasks/new" method="POST">
                <button type="submit" class="add-task-btn"> Add Task </button>
            </form>

            <div
                class="task-container"
            >

                <ul
                    class="task-list"
                >
                    <% if (locals.tasks) { %>

                        <% tasks.forEach(task => { %>

                            <li class="task-li">
                                <form class="task-form" action="/tasks" method="POST">
                                    <input type="text" name="taskID" value="<%= task.id %>" hidden>
                                    <input class="task-inp" type="text" name="task" placeholder="Untitled" value='<%= task.text %>'>
                                    <button type="submit" hidden></button> 
                                </form>
                            </li>

                        <% }) %>

                    <% } %>

                </ul>

            </div>

        </main>

    </div>
    <script src="scripts/index.js" type="module"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="scripts/index-gsap.js"></script>
</body>
</html>